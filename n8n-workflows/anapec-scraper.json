{
  "name": "MEIP - ANAPEC Automated Job Scraper & Ingestion Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "1b9a8f20-9c12-4e8b-871d-111111111111",
      "name": "Schedule Trigger (6h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.anapec.org/sigec-app-rv/recherche_offres",
        "options": {
          "headers": {
            "User-Agent": "MEIP-Labor-Intelligence-Bot/2.0 (+https://meip.ma)"
          }
        }
      },
      "id": "2c9a8f20-9c12-4e8b-871d-222222222222",
      "name": "Fetch ANAPEC Job Portal HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "extractHtml",
        "extractionValues": {
          "values": [
            {
              "key": "job_titles",
              "cssSelector": ".offre_title a",
              "returnArray": true
            },
            {
              "key": "company_names",
              "cssSelector": ".company_name",
              "returnArray": true
            },
            {
              "key": "locations",
              "cssSelector": ".location_tag",
              "returnArray": true
            },
            {
              "key": "contract_types",
              "cssSelector": ".contract_type",
              "returnArray": true
            }
          ]
        }
      },
      "id": "3d9a8f20-9c12-4e8b-871d-333333333333",
      "name": "Parse ANAPEC Job Cards",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// MEIP Data Cleaning & Normalization for ANAPEC\nconst items = $input.all();\nconst cleanedJobs = [];\n\nfor (const item of items) {\n  const titles = item.json.job_titles || [];\n  const companies = item.json.company_names || [];\n  const locations = item.json.locations || [];\n  const contracts = item.json.contract_types || [];\n\n  for (let i = 0; i < titles.length; i++) {\n    const rawTitle = (titles[i] || '').trim();\n    const rawCompany = (companies[i] || 'Confidential ANAPEC Client').trim();\n    const rawLocation = (locations[i] || 'Casablanca').trim();\n    const rawContract = (contracts[i] || 'CDI').trim();\n\n    if (!rawTitle) continue;\n\n    cleanedJobs.push({\n      json: {\n        title: rawTitle,\n        company: rawCompany,\n        location: rawLocation,\n        source: 'ANAPEC',\n        contract_type: rawContract,\n        scraped_at: new Date().toISOString(),
        is_active: true\n      }\n    });\n  }\n}\n\nreturn cleanedJobs;"
      },
      "id": "4e9a8f20-9c12-4e8b-871d-444444444444",
      "name": "Clean & Standardize Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jobs (title, company, location, source, contract_type, created_at, is_active)\nVALUES ($1, $2, $3, $4, $5, NOW(), true)\nON CONFLICT (title, company, source) DO UPDATE SET updated_at = NOW();\n\nINSERT INTO pipeline_logs (source_name, records_harvested, execution_status, execution_time_ms, created_at)\nVALUES ('ANAPEC', $6, 'SUCCESS', 142, NOW());",
        "queryParams": "={{ [$json.title, $json.company, $json.location, $json.source, $json.contract_type, $input.all().length] }}"
      },
      "id": "5f9a8f20-9c12-4e8b-871d-555555555555",
      "name": "Upsert to Supabase PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1140,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "MEIP_SUPABASE_POSTGRES_CREDENTIALS",
          "name": "Supabase Production PostgreSQL DB"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger (6h)": {
      "main": [
        [
          {
            "node": "Fetch ANAPEC Job Portal HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch ANAPEC Job Portal HTML": {
      "main": [
        [
          {
            "node": "Parse ANAPEC Job Cards",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse ANAPEC Job Cards": {
      "main": [
        [
          {
            "node": "Clean & Standardize Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clean & Standardize Fields": {
      "main": [
        [
          {
            "node": "Upsert to Supabase PostgreSQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "meta": {
    "templateId": "meip-anapec-scraper"
  },
  "tags": [
    "MEIP",
    "ANAPEC",
    "ETL",
    "Scraper",
    "Supabase"
  ]
}
